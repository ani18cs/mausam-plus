# Mausam+ Environment Variables Configuration Template
# Copy this file to .env before starting the BFF service or mobile app

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# External Weather & Environmental Data APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPENAQ_API_KEY=your_openaq_api_key_placeholder
WORLDTIDES_API_KEY=your_worldtides_api_key_placeholder

# Conversational AI & LLM Orchestration
LLM_API_KEY=your_openai_or_anthropic_api_key_placeholder
LLM_MODEL=gpt-4o-mini

# Database & Storage (Citizen Reports & User Preferences)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder

# Frontend Vite Public Variables
VITE_BFF_API_URL=http://localhost:4000/api
